{
  "manifestVersion": 5,
  "id": "com.acreami.ditherforge",
  "name": "DitherForge",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "ditherforgePanel",
      "label": "DitherForge",
      "minimumSize": {
        "width": 320,
        "height": 560
      },
      "maximumSize": {
        "width": 420,
        "height": 900
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 720
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
